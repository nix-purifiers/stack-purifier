cabal-version: 2.4
name: example
version: 0.1.0.0
build-type: Simple
executable example
  main-is: Main.hs
  build-depends: base >= 4.20 && < 5, split == 0.2.5
  default-language: Haskell2010

test-suite example-test
  type: exitcode-stdio-1.0
  main-is: Test.hs
  build-depends: base >= 4.20 && < 5, split == 0.2.5
  default-language: Haskell2010
